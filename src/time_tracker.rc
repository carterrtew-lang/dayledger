// Resources of TimeTracker.exe (DayLedger): application icon, manifest and version info.
#pragma code_page(65001)
#include <winver.h>

1 ICON "app.ico"

// RT_MANIFEST = 24, id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID; linkers must not add another one.
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,4,0,0
PRODUCTVERSION 2,4,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "时光账本 DayLedger"
            VALUE "FileVersion", "2.4.0"
            VALUE "InternalName", "TimeTracker"
            VALUE "OriginalFilename", "TimeTracker.exe"
            VALUE "ProductName", "时光账本 DayLedger"
            VALUE "ProductVersion", "2.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
